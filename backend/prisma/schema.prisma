generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ACCOUNTANT
  CONTACT
}

enum ContactType {
  CUSTOMER
  VENDOR
  BOTH
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ProductType {
  GOODS
  SERVICE
  COMBO
}

enum AccountType {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
  CAPITAL
}

enum JournalType {
  SALES
  PURCHASE
  BANK
  CASH
}

enum SourceType {
  PURCHASE_ORDER
  SALES_ORDER
  VENDOR_BILL
  CUSTOMER_INVOICE
  PAYMENT
  MANUAL
}

enum PurchaseOrderStatus {
  DRAFT
  CONFIRMED
  BILLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  INVOICED
}

enum BillInvoiceStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  BANK
}

enum AnalyticAccountType {
  INCOME
  EXPENSE
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  passwordHash       String
  role               UserRole   @default(ACCOUNTANT)
  contactId          String?    @unique
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  contact            Contact?   @relation(fields: [contactId], references: [id])
  journalEntries     JournalEntry[]
  responsibleBudgets Budget[]

  @@index([role])
  @@index([contactId])
  @@index([email])
}

model Contact {
  id               String            @id @default(cuid())
  name             String
  email            String            @unique
  phone            String?
  address          String?
  type             ContactType       @default(CUSTOMER)
  status           RecordStatus      @default(ACTIVE)
  taxId            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?
  purchaseOrders   PurchaseOrder[]
  vendorBills      VendorBill[]
  salesOrders      SalesOrder[]
  customerInvoices CustomerInvoice[]
  payments         Payment[]

  @@index([status])
  @@index([type])
  @@index([name])
  @@index([email])
}

model Product {
  id                  String              @id @default(cuid())
  name                String
  type                ProductType         @default(GOODS)
  salesPrice          Decimal             @db.Decimal(12, 2)
  cost                Decimal             @default(0) @db.Decimal(12, 2)
  category            String
  description         String?
  status              RecordStatus        @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  purchaseOrderLines  PurchaseOrderLine[]
  salesOrderLines     SalesOrderLine[]

  @@index([category])
  @@index([status])
  @@index([name])
}

model Account {
  id               String            @id @default(cuid())
  name             String            @unique
  type             AccountType
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  defaultJournals  Journal[]
  journalItems     JournalItem[]

  @@index([type])
  @@index([isActive])
}

model Journal {
  id               String         @id @default(cuid())
  name             String
  type             JournalType
  defaultAccountId String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  defaultAccount   Account?       @relation(fields: [defaultAccountId], references: [id])
  entries          JournalEntry[]

  @@index([type])
  @@index([defaultAccountId])
}

model JournalEntry {
  id            String        @id @default(cuid())
  journalId     String
  date          DateTime      @db.Date
  reference     String?
  sourceType    SourceType?
  sourceId      String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  journal       Journal       @relation(fields: [journalId], references: [id])
  createdBy     User          @relation(fields: [createdById], references: [id])
  items         JournalItem[]
  vendorBill    VendorBill?
  customerInvoice CustomerInvoice?
  payment       Payment?

  @@index([journalId])
  @@index([createdById])
  @@index([date])
  @@index([sourceType])
  @@index([sourceId])
}

model JournalItem {
  id                String           @id @default(cuid())
  journalEntryId    String
  accountId         String
  analyticAccountId String?
  debit             Decimal          @default(0) @db.Decimal(14, 2)
  credit            Decimal          @default(0) @db.Decimal(14, 2)
  description       String?
  createdAt         DateTime         @default(now())
  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account           Account          @relation(fields: [accountId], references: [id])
  analyticAccount   AnalyticAccount? @relation(fields: [analyticAccountId], references: [id])

  @@index([journalEntryId])
  @@index([accountId])
  @@index([analyticAccountId])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  contactId   String
  date        DateTime            @db.Date
  status      PurchaseOrderStatus @default(DRAFT)
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  contact     Contact             @relation(fields: [contactId], references: [id])
  lines       PurchaseOrderLine[]
  vendorBills VendorBill[]

  @@index([contactId])
  @@index([status])
  @@index([date])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Decimal       @db.Decimal(12, 4)
  unitPrice       Decimal       @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product         Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model VendorBill {
  id              String            @id @default(cuid())
  purchaseOrderId String?
  contactId       String
  invoiceDate     DateTime          @db.Date
  dueDate         DateTime?         @db.Date
  status          BillInvoiceStatus @default(UNPAID)
  totalAmount     Decimal           @default(0) @db.Decimal(14, 2)
  journalEntryId  String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  contact         Contact           @relation(fields: [contactId], references: [id])
  purchaseOrder   PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  journalEntry    JournalEntry      @relation(fields: [journalEntryId], references: [id])
  payments        Payment[]

  @@index([contactId])
  @@index([purchaseOrderId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([journalEntryId])
}

model SalesOrder {
  id               String           @id @default(cuid())
  contactId        String
  date             DateTime         @db.Date
  status           SalesOrderStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  contact          Contact          @relation(fields: [contactId], references: [id])
  lines            SalesOrderLine[]
  customerInvoices CustomerInvoice[]

  @@index([contactId])
  @@index([status])
  @@index([date])
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  salesOrderId String
  productId    String
  quantity     Decimal    @db.Decimal(12, 4)
  unitPrice    Decimal    @db.Decimal(12, 2)
  tax          Decimal    @default(0) @db.Decimal(12, 2)
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id])

  @@index([salesOrderId])
  @@index([productId])
}

model CustomerInvoice {
  id             String            @id @default(cuid())
  salesOrderId   String?
  contactId      String
  invoiceDate    DateTime          @db.Date
  dueDate        DateTime?         @db.Date
  status         BillInvoiceStatus @default(UNPAID)
  totalAmount    Decimal           @default(0) @db.Decimal(14, 2)
  journalEntryId String            @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  contact        Contact           @relation(fields: [contactId], references: [id])
  salesOrder     SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  journalEntry   JournalEntry      @relation(fields: [journalEntryId], references: [id])
  payments       Payment[]

  @@index([contactId])
  @@index([salesOrderId])
  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([journalEntryId])
}

model Payment {
  id                String           @id @default(cuid())
  contactId         String
  billId            String?
  invoiceId         String?
  method            PaymentMethod
  amount            Decimal          @db.Decimal(14, 2)
  date              DateTime         @db.Date
  journalEntryId    String           @unique
  reference         String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  contact           Contact          @relation(fields: [contactId], references: [id])
  vendorBill        VendorBill?      @relation(fields: [billId], references: [id])
  customerInvoice   CustomerInvoice? @relation(fields: [invoiceId], references: [id])
  journalEntry      JournalEntry     @relation(fields: [journalEntryId], references: [id])

  @@index([contactId])
  @@index([billId])
  @@index([invoiceId])
  @@index([date])
  @@index([method])
  @@index([journalEntryId])
}

model AnalyticAccount {
  id           String              @id @default(cuid())
  name         String              @unique
  type         AnalyticAccountType
  status       RecordStatus        @default(ACTIVE)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  budgets      Budget[]
  journalItems JournalItem[]

  @@index([type])
  @@index([status])
}

model Budget {
  id                  String          @id @default(cuid())
  name                String
  periodStart         DateTime        @db.Date
  periodEnd           DateTime        @db.Date
  plannedAmount       Decimal         @db.Decimal(14, 2)
  analyticAccountId   String
  responsiblePersonId String
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  analyticAccount     AnalyticAccount @relation(fields: [analyticAccountId], references: [id])
  responsiblePerson   User            @relation(fields: [responsiblePersonId], references: [id])

  @@index([analyticAccountId])
  @@index([responsiblePersonId])
  @@index([periodStart])
  @@index([periodEnd])
}
